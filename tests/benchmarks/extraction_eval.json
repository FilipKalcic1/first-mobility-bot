  "_meta": {
    "purpose": "Honest ONE-SHOT extraction accuracy (Filip 2026-05-24). Measures whether the bot pulls STATED values from a single message into the RIGHT param, right value, right format. NOT routing (that's measured separately). Every expected value is explicitly present in the query, so missing/wrong = real extraction failure.",
    "kinds": {
      "path_id": "integer {id} in path — measured via LLM router tool-call args",
      "body_num": "numeric body value — measured via LLM router tool-call args",
      "registration": "DEAD (entity_detector removed in 8f9ba4d) — not scored by any bench part",
      "registration_negative": "DEAD (entity_detector removed in 8f9ba4d) — not scored",
      "datetime": "date / date-time / range params — measures whether the LLM-extracted value is in CORRECT ISO 8601 format. Scored format-aware (CORRECT/WRONG_FORMAT/WRONG_VALUE/MISSING), NOT digit-normalized. Router is forced to expected_tool (singleton tool_filter) to ISOLATE extraction-format from routing. 'expected' maps param_name -> {iso: '...'} (absolute) or {rel: {base, time?}} (relative, resolved at runtime). Note: relative dates (sutra/u petak) test whether the system can resolve them on the LLM path at all — llm_router does NOT inject today's date, so the LLM has no date context (param_ui coercion does, but only on the param-ASK path, not LLM extraction)."
    },
    "datetime_params_verified_from": "config/tool_data.json 2026-05-25: post_PeriodicActivities.Date (req,date-time); post_VehicleCalendar.FromTime(req)/ToTime(opt) date-time; post_VehicleAssignments.FromTime/ToTime date-time",
